---
// A cinematic editorial interlude in the PRACTICE's own voice — not a client
// testimonial. Real client reflections can replace this later, shared only with
// consent. Keeping integrity: no fabricated reviews.
const ethos =
  "Healing was never about becoming someone new. It is about remembering who you were beneath the noise — and letting that self breathe again.";
---

<section
  class="grain relative overflow-hidden bg-forest py-28 text-cream sm:py-36"
  aria-labelledby="ethos-heading"
>
  <!-- Soft drifting light, echoing the hero -->
  <div class="aurora" aria-hidden="true">
    <span class="aurora-blob aurora-gold" style="opacity:0.32"></span>
    <span class="aurora-blob aurora-sage" style="opacity:0.32"></span>
  </div>
  <div
    class="pointer-events-none absolute inset-0 opacity-50"
    style="background: radial-gradient(ellipse 70% 55% at 50% 0%, #c2a24c22 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-4xl px-6 text-center sm:px-8">
    <p class="reveal eyebrow text-gold/90">Our ethos</p>

    <span
      class="reveal reveal-delay-1 mx-auto mt-6 block font-display text-7xl leading-none text-gold/70 sm:text-8xl"
      aria-hidden="true">&ldquo;</span
    >

    <blockquote
      id="ethos-heading"
      class="reveal reveal-delay-2 -mt-4 font-display text-2xl italic leading-snug text-balance text-cream sm:text-4xl sm:leading-tight"
    >
      {ethos}
    </blockquote>

    <div class="reveal reveal-delay-3 mx-auto mt-10 h-px w-24 hairline"></div>

    <p class="reveal reveal-delay-3 mt-6 text-sm uppercase tracking-[0.28em] text-gold/80">
      Ashley Romero &middot; Hometown Serenity
    </p>

    <p class="reveal reveal-delay-4 prose-width mx-auto mt-10 text-pretty text-sm leading-relaxed text-cream/60">
      Client reflections will be shared here in time — always authentic, always
      with permission. If you've walked this path with Ashley and wish to share
      your voice, reach out any time.
    </p>
  </div>
</section>
