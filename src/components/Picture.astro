---
import manifest from "../data/image-manifest.json";

interface Props {
  /** Base path without extension, e.g. /images/hero */
  base: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  /** Responsive sizes hint (how wide the image renders across breakpoints) */
  sizes?: string;
  /** Force PNG fallback (badges with transparency). Inferred from manifest too. */
  png?: boolean;
}

const {
  base,
  alt,
  class: className = "",
  loading = "lazy",
  fetchpriority,
  sizes = "100vw",
  png,
} = Astro.props;

const key = base.replace(/^\/images\//, "");
const entry = (manifest as Record<string, any>)[key];

const isPng = png ?? entry?.png ?? false;
const fallbackExt = isPng ? "png" : "jpg";
const fallbackSrc = `${base}.${fallbackExt}`;
const width = entry?.w;
const height = entry?.h;

/** Build a srcset string for one format from the manifest widths. */
const srcset = (ext: string) =>
  entry?.widths?.map((w: number) => `${base}-${w}.${ext} ${w}w`).join(", ");
---

{
  entry && !entry.png ? (
    <picture>
      <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
      <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
      <img
        src={fallbackSrc}
        srcset={srcset("jpg")}
        sizes={sizes}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        class={className}
      />
    </picture>
  ) : (
    <picture>
      <source srcset={`${base}.webp`} type="image/webp" />
      <img
        src={fallbackSrc}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        class={className}
      />
    </picture>
  )
}
