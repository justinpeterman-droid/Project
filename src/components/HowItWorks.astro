---
import { howItWorks, booking } from "../data/site";
import Button from "./Button.astro";
---

<section
  class="scroll-mt-24 bg-canvas py-24 sm:py-32"
  aria-labelledby="how-heading"
>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="reveal eyebrow">Your path</p>
      <h2
        id="how-heading"
        class="reveal reveal-delay-1 mt-4 font-display text-3xl text-balance text-ink sm:text-4xl md:text-5xl"
      >
        How we work together
      </h2>
      <p class="reveal reveal-delay-2 prose-width mx-auto mt-6 text-pretty text-lg text-muted">
        A clear rhythm from first conversation to ongoing integration — at your
        pace.
      </p>
    </div>

    <ol class="card-stack mt-14 flex flex-col gap-6 md:mt-20 md:gap-8">
      {
        howItWorks.map((step, i) => (
          <li class="stack-card" style={`--index:${i}`}>
            <div class="overflow-hidden rounded-3xl border border-sand/80 bg-cream shadow-lift">
              <div class="flex flex-col gap-6 p-8 sm:p-10 md:flex-row md:items-center md:gap-12 md:p-14">
                <div class="flex shrink-0 items-baseline gap-3 md:w-1/3 md:flex-col md:items-start md:gap-4">
                  <span class="text-xs font-semibold uppercase tracking-[0.28em] text-clay-deep">
                    Step {String(i + 1).padStart(2, "0")}
                  </span>
                  <span
                    class="bg-gradient-to-br from-clay via-gold to-sage-deep bg-clip-text font-display text-[4rem] leading-none text-transparent sm:text-[5.5rem] md:text-[7rem]"
                    aria-hidden="true"
                  >
                    {step.step}
                  </span>
                </div>
                <div class="md:flex-1">
                  <div class="mb-5 h-px w-16 hairline md:mb-6"></div>
                  <h3 class="font-display text-2xl text-ink sm:text-3xl">{step.title}</h3>
                  <p class="mt-4 max-w-xl text-pretty text-base leading-relaxed text-muted">
                    {step.body}
                  </p>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="reveal reveal-delay-4 mt-12 text-center">
      <Button href={booking.url} variant="primary" size="lg" external>
        {booking.discovery.label}
      </Button>
    </div>
  </div>
</section>
