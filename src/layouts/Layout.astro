---
import { ClientRouter } from "astro:transitions";
// Self-hosted variable fonts (bundled + hashed by Vite, served same-origin).
// opsz variants carry the optical-size axis used by font-optical-sizing.
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/dm-sans/standard.css";
import "../styles/global.css";
import { site, images } from "../data/site";
import { buildFaqJsonLd, buildPageJsonLd } from "../lib/structured-data";
import manifest from "../data/image-manifest.json";
// Preload the critical latin variable-font files so they're ready before first
// paint — eliminates the font-swap reflow (CLS) of the large hero headline.
import frauncesFont from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";

// AVIF srcset for the hero LCP preload, built from the generated variants.
const heroKey = images.hero.base.replace(/^\/images\//, "");
const heroWidths: number[] = (manifest as Record<string, any>)[heroKey]?.widths ?? [];
const heroSrcset = heroWidths
  .map((w) => `${images.hero.base}-${w}.avif ${w}w`)
  .join(", ");

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical/OG, e.g. "/" */
  path?: string;
  image?: string;
  imageAlt?: string;
  /** Preload hero for LCP on home */
  preloadHero?: boolean;
  /** Include FAQPage schema (home only) */
  includeFaqSchema?: boolean;
}

const {
  title,
  description,
  path = "/",
  image = site.seo.ogImage,
  imageAlt = site.seo.ogImageAlt,
  preloadHero = false,
  includeFaqSchema = false,
} = Astro.props;

const isHome = path === "/";
const pageTitle = title
  ? `${title} · ${site.name}`
  : site.seo.title;
const metaDescription = description ?? (isHome ? site.seo.description : site.description);

const canonical = new URL(path, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const ogWidth = 1200;
const ogHeight = 630;

const jsonLd = buildPageJsonLd();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Preload the display font (large hero headline) to prevent swap reflow / CLS -->
    <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbf8f3" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={`${images.hero.base}-1280.avif`}
          imagesrcset={heroSrcset}
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    {
      includeFaqSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFaqJsonLd())} />
      )
    }

    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-forest focus:px-4 focus:py-2 focus:text-cream"
      >Skip to content</a
    >
    <slot />

    <script is:inline>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const fine = window.matchMedia("(pointer: fine)").matches;

        const initReveal = () => {
          const els = document.querySelectorAll(
            ".reveal:not(.is-visible), .reveal-left:not(.is-visible), .reveal-right:not(.is-visible)"
          );
          if (!("IntersectionObserver" in window) || reduce) {
            els.forEach((el) => el.classList.add("is-visible"));
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
          );
          els.forEach((el) => io.observe(el));
        };

        // Magnetic buttons: primary CTAs drift subtly toward the cursor.
        const initMagnetic = () => {
          if (reduce || !fine) return;
          document.querySelectorAll("[data-magnetic]:not([data-wired])").forEach((el) => {
            el.setAttribute("data-wired", "");
            const strength = 0.28;
            el.addEventListener("pointermove", (e) => {
              const r = el.getBoundingClientRect();
              const x = (e.clientX - (r.left + r.width / 2)) * strength;
              const y = (e.clientY - (r.top + r.height / 2)) * strength;
              el.style.transform = `translate(${x}px, ${y}px)`;
            });
            el.addEventListener("pointerleave", () => {
              el.style.transform = "";
            });
          });
        };

        const boot = () => { initReveal(); initMagnetic(); };
        boot();
        document.addEventListener("astro:page-load", boot);
      })();
    </script>
  </body>
</html>
