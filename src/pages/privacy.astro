---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Compliance from "../components/Compliance.astro";
import { site, contact, legal } from "../data/site";

const privacyDescription =
  "How Hometown Serenity collects, uses, and protects your information. Contact Ashley Romero for privacy questions.";
---

<Layout
  title="Privacy"
  path="/privacy"
  description={privacyDescription}
  image={site.seo.ogImage}
>
  <Header />
  <main
    id="main"
    transition:name="page-content"
    class="mx-auto max-w-3xl px-5 pb-24 pt-32 sm:px-8"
  >
    <p class="eyebrow">Legal</p>
    <h1 class="mt-4 font-display text-4xl text-ink">Privacy policy</h1>
    <p class="mt-3 text-xs uppercase tracking-[0.2em] text-faint">Last updated: July 2026</p>
    <p class="prose-width mt-6 text-muted">
      Hometown Serenity respects your privacy. This policy explains how we handle
      information when you visit this website, book a session, or contact Ashley
      Romero directly.
    </p>

    <section class="mt-10 space-y-8">
      <div>
        <h2 class="font-display text-xl text-ink">Information we collect</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          When you book through our scheduling link, submit a form, or email us, you
          may provide your name, contact details, and information you choose to share
          about your goals. Technical data such as browser type or IP address may be
          collected by our hosting provider for security and performance.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">How we use it</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          Information is used to respond to inquiries, schedule and provide sessions,
          share resources you request, and maintain this website. We do not sell or
          rent your personal information, and we do not use it for advertising.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Cookies &amp; analytics</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          This website does not set advertising or cross-site tracking cookies and
          does not run third-party analytics. Our hosting provider may use strictly
          necessary cookies to keep the site secure and available. Third-party tools
          you choose to use (such as a booking or form page) may set their own
          cookies, governed by their policies.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Third-party services</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          Booking, forms, and resource links may be hosted by third parties — for
          example Google Calendar, Jotform, and Google Drive — and this site is served
          by our hosting provider (Netlify). When you use those services, their own
          privacy policies apply. We encourage you to review them.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">How long we keep it</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          We keep the information you share only as long as needed to respond to you,
          provide the services you requested, and meet any legal or record-keeping
          obligations — then delete it or keep it securely archived.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Your choices</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          You may ask us to access, correct, or delete the personal information you
          have shared with us, or opt out of future messages, by contacting Ashley
          using the details below. We will respond within a reasonable time.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Wellness disclaimer</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          Hometown Serenity offers holistic hypnotherapy, coaching, and wellness
          support. These services are not medical, psychological, or psychiatric
          diagnosis or treatment, and are not a substitute for care from a licensed
          healthcare provider. If you are experiencing a medical or mental-health
          emergency, please contact your doctor or emergency services.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Children's privacy</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          This website is intended for adults. We do not knowingly collect personal
          information from children under 18. If you believe a child has provided us
          information, please contact us and we will remove it.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Changes to this policy</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          We may update this policy from time to time. Material changes will be
          reflected here with a new "last updated" date above.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl text-ink">Contact</h2>
        <p class="prose-width mt-3 text-sm leading-relaxed text-muted">
          Questions about this policy or your data:
        </p>
        <ul class="mt-4 space-y-2 text-sm text-loam">
          <li>
            Email: <a href={contact.emailHref} class="text-clay-deep underline"
              >{contact.email}</a
            >
          </li>
          <li>
            Phone: <a href={contact.phoneHref} class="text-clay-deep underline"
              >{contact.phone}</a
            >
          </li>
        </ul>
      </div>
    </section>

    <div class="mt-12">
      <Compliance />
    </div>
    <p class="mt-8 text-xs text-faint">{legal.copyright}</p>
  </main>
  <Footer />
</Layout>
